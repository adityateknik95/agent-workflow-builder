# Copy to .env for local development. The defaults line up with docker-compose.yml,
# so if you started the stack with `docker compose up -d` you can copy this file
# unchanged.

# --- backend endpoints -------------------------------------------------------
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080
HASURA_GRAPHQL_ADMIN_SECRET=nhost-admin-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
AUTH_URL=http://localhost:4000/v1

# Shared secret Hasura presents to the Action / Event Trigger handlers. Must match
# the value given to the Hasura container. nhost injects this for you in the cloud.
NHOST_WEBHOOK_SECRET=local-webhook-secret

# Port the local functions dev server listens on. Hasura's NHOST_FUNCTIONS_URL
# must point at it.
FUNCTIONS_PORT=3001

# --- LLM provider for llm_call steps ----------------------------------------
# Leave LLM_PROVIDER=stub to run without any API key: llm_call then returns a
# deterministic classification after an artificial delay, and every step_run
# records "stubbed": true so it is obvious in the UI that no real call was made.
#
# For real calls set one of:
#   LLM_PROVIDER=groq        + LLM_API_KEY=gsk_...            (free tier)
#   LLM_PROVIDER=openrouter  + LLM_API_KEY=sk-or-...          (free tier)
#   LLM_PROVIDER=gemini      + LLM_API_KEY=AIza...            (free tier)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- notify step -------------------------------------------------------------
# Optional. Without it, `notify` steps still run and are recorded, and the
# notification row is marked sent with delivery skipped.
SLACK_WEBHOOK_URL=

# --- frontend ---------------------------------------------------------------
# These are read by web/ (Next.js). Same values as above, public by nature.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:8080/v1/graphql
NEXT_PUBLIC_AUTH_URL=http://localhost:4000/v1
