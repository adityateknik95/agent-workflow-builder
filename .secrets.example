# Secret values referenced as {{ secrets.NAME }} in nhost.toml.
#
# Copy to `.secrets` (gitignored) before running `nhost up` or
# `nhost config validate`. In nhost cloud these are set in the dashboard under
# the project's secrets, not from this file.
#
# Generate fresh values for the first three, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

HASURA_GRAPHQL_ADMIN_SECRET = 'replace-me-with-a-random-48-char-hex-string'
HASURA_GRAPHQL_JWT_SECRET = 'replace-me-with-a-random-64-char-hex-string'
NHOST_WEBHOOK_SECRET = 'replace-me-with-a-random-48-char-hex-string'
GRAFANA_ADMIN_PASSWORD = 'replace-me'

# llm_call runs against the built-in stub when LLM_PROVIDER is 'stub' or the key
# is blank. Set groq / openrouter / gemini plus a key for real calls.
LLM_PROVIDER = 'stub'
LLM_API_KEY = ''
LLM_MODEL = 'llama-3.3-70b-versatile'

# Optional. Without it, notify steps are recorded and marked `skipped`.
SLACK_WEBHOOK_URL = ''
